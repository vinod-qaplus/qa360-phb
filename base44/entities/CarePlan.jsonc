{
  "name": "CarePlan",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "description": "Reference to PHBCase entity ID"
    },
    "patient_id": {
      "type": "string",
      "description": "Reference to Patient entity ID"
    },
    "patient_name": {
      "type": "string",
      "description": "Patient full name"
    },
    "version": {
      "type": "number",
      "description": "Care plan version number"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Submitted",
        "Under Review",
        "Approved",
        "Active",
        "Superseded",
        "Archived"
      ],
      "default": "Draft",
      "description": "Care plan status"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Care plan start date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Care plan end date"
    },
    "primary_needs": {
      "type": "string",
      "description": "Primary health/care needs"
    },
    "outcomes": {
      "type": "string",
      "description": "Desired outcomes"
    },
    "services_required": {
      "type": "string",
      "description": "Services required to meet needs"
    },
    "risk_assessment": {
      "type": "string",
      "description": "Risk assessment notes"
    },
    "safeguarding_notes": {
      "type": "string",
      "description": "Safeguarding considerations"
    },
    "patient_consent": {
      "type": "boolean",
      "description": "Patient has given consent"
    },
    "consent_date": {
      "type": "string",
      "format": "date",
      "description": "Date consent was given"
    },
    "approved_by": {
      "type": "string",
      "description": "Email of approver"
    },
    "approval_date": {
      "type": "string",
      "format": "date",
      "description": "Date approved"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "case_id",
    "patient_id",
    "patient_name",
    "version"
  ]
}